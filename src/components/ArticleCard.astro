---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  slug: string;
}

const { title, excerpt, date, slug } = Astro.props;
---

<a href={`/blog/${slug}`} class="group block border-t border-border py-6">
  <div class="grid md:grid-cols-[7.5rem_1fr] gap-2 md:gap-5">
    {date ? <time class="font-mono text-xs text-muted-foreground/70 md:pt-1.5">{date}</time> : <span></span>}
    <div>
      <h3 class="max-w-[52ch] group-hover:text-primary transition-colors">{title}</h3>
      <p class="mt-2 text-sm text-muted-foreground leading-relaxed max-w-[68ch]">{excerpt}</p>
    </div>
  </div>
</a>
