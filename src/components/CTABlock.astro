---
interface Props {
  heading?: string;
  text?: string;
  linkText?: string;
  linkTo?: string;
}

const {
  heading = "Let's talk.",
  text = 'If you need someone to own organic and AI search at your B2B SaaS company, start a conversation.',
  linkText = 'Get in touch',
  linkTo = '/contact',
} = Astro.props;
---

<section id="contact" class="bg-foreground text-background" aria-labelledby="contact-heading">
  <div class="container py-16 md:py-20">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-7">
        <h2 id="contact-heading" class="text-white">{heading}</h2>
        <p class="mt-5 text-white/75 max-w-[56ch] text-lg leading-relaxed">{text}</p>
        <div class="mt-8">
          <a href={linkTo} class="btn-invert focus-visible:outline-white">
            {linkText}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
      <div class="md:col-span-5 md:pt-2">
        <p class="text-sm text-white/60">Email</p>
        <a
          href="mailto:joe@joerobinson.io"
          class="mt-1 inline-block text-xl md:text-2xl font-semibold text-white underline decoration-white/30 underline-offset-[6px] hover:decoration-white transition-colors focus-visible:outline-white"
        >joe@joerobinson.io</a>
        <p class="mt-6 text-sm text-white/60">LinkedIn</p>
        <a
          href="https://www.linkedin.com/in/robinson-j/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 inline-block text-white underline decoration-white/30 underline-offset-4 hover:decoration-white transition-colors focus-visible:outline-white"
        >linkedin.com/in/robinson-j<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </div>
</section>
