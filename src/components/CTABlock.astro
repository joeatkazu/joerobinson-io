---
interface Props {
  heading?: string;
  text?: string;
  linkText?: string;
  linkTo?: string;
}

const {
  heading = "Let's talk.",
  text = 'If you need someone to own organic and AI search at your B2B SaaS company, start a conversation.',
  linkText = 'Get in touch',
  linkTo = '/contact',
} = Astro.props;
---

<section class="border-t border-border bg-secondary">
  <div class="container py-14 md:py-20">
    <div class="flex items-baseline gap-3 text-xs sm:text-sm mb-8">
      <span class="text-primary">[--]</span>
      <span class="text-foreground uppercase tracking-[0.08em]">Contact</span>
      <span class="leader"></span>
    </div>
    <h2 class="max-w-[24ch]">{heading}</h2>
    <p class="mt-5 text-muted-foreground max-w-[64ch] leading-relaxed">{text}</p>
    <div class="mt-9">
      <a href={linkTo} class="btn">
        <span aria-hidden="true">&rarr;</span>
        {linkText}
      </a>
    </div>
  </div>
</section>
