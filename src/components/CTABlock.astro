---
interface Props {
  heading?: string;
  text?: string;
  linkText?: string;
  linkTo?: string;
}

const {
  heading = "Let's talk.",
  text = 'If you need someone to own organic and AI search at your B2B SaaS company, start a conversation.',
  linkText = 'Get in touch',
  linkTo = '/contact',
} = Astro.props;
---

<section>
  <div class="container">
    <div class="sheet sheet-ink">
      <span class="label block text-background/55 mb-6">[--] Contact</span>
      <h2 class="max-w-[24ch] text-white">{heading}</h2>
      <p class="mt-5 text-background/70 max-w-[64ch] leading-relaxed">{text}</p>
      <div class="mt-9">
        <a href={linkTo} class="btn-invert">
          <span aria-hidden="true">&rarr;</span>
          {linkText}
        </a>
      </div>
    </div>
  </div>
</section>
