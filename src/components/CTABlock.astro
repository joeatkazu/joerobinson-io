---
interface Props {
  heading?: string;
  text?: string;
  linkText?: string;
  linkTo?: string;
}

const {
  heading = "Let's talk.",
  text = 'If you need someone to own organic and AI search at your B2B SaaS company, start a conversation.',
  linkText = 'Get in touch',
  linkTo = '/contact',
} = Astro.props;
---

<section class="bg-foreground text-background">
  <div class="container py-16 md:py-24">
    <div class="grid md:grid-cols-2 gap-10 items-end">
      <div>
        <h2 class="text-background text-4xl md:text-5xl">{heading}</h2>
        <p class="mt-5 text-background/70 text-lg max-w-[46ch]">{text}</p>
      </div>
      <div class="md:justify-self-end">
        <a
          href={linkTo}
          class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-4 text-base font-semibold hover:bg-background hover:text-foreground transition-colors"
        >
          {linkText}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
