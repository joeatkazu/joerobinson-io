---
interface Props {
  title: string;
  label?: string;
  description?: string;
}

const { title, label, description } = Astro.props;
---

<div class="border-t border-foreground/80 pt-5 h-full">
  {label && <span class="label block text-primary mb-3">{label}</span>}
  <h3 class="mb-3">{title}</h3>
  {description && <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>}
  <div class="text-sm text-muted-foreground leading-relaxed space-y-3">
    <slot />
  </div>
</div>
