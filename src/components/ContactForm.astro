---
---

<div class="grid md:grid-cols-2 gap-12 md:gap-16">
  <div>
    <p class="text-lg text-muted-foreground leading-relaxed mb-8 max-w-[46ch]">
      I work with two or three retained clients at a time, to keep the work deep rather than wide.
      If you're facing SEO challenges or want to be part of the recommendation set in AI search,
      I'd welcome a conversation.
    </p>
    <a
      href="mailto:joe@joerobinson.io"
      class="link-accent text-base border-b-2 border-primary"
    >
      joe@joerobinson.io
    </a>
    <p class="text-sm text-muted-foreground mt-8">Typically respond within 24 hours.</p>
  </div>

  <!-- Set action to your form endpoint, e.g. https://formspree.io/f/your-id -->
  <form class="space-y-5 border-t-2 border-foreground pt-8" method="post" action="mailto:joe@joerobinson.io">
    <div>
      <label for="name" class="block text-xs font-bold uppercase tracking-[0.1em] text-foreground mb-2">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        class="w-full bg-background border-2 border-foreground px-4 py-3 text-base text-foreground placeholder:text-muted-foreground/70 focus:outline-none focus:border-primary transition-colors"
        placeholder="Your name"
      />
    </div>
    <div>
      <label for="email" class="block text-xs font-bold uppercase tracking-[0.1em] text-foreground mb-2">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        class="w-full bg-background border-2 border-foreground px-4 py-3 text-base text-foreground placeholder:text-muted-foreground/70 focus:outline-none focus:border-primary transition-colors"
        placeholder="you@company.com"
      />
    </div>
    <div>
      <label for="message" class="block text-xs font-bold uppercase tracking-[0.1em] text-foreground mb-2">Message</label>
      <textarea
        id="message"
        name="message"
        rows="6"
        class="w-full bg-background border-2 border-foreground px-4 py-3 text-base text-foreground placeholder:text-muted-foreground/70 focus:outline-none focus:border-primary transition-colors resize-none"
        placeholder="Tell me about your company and what you're trying to fix"
      ></textarea>
    </div>
    <button type="submit" class="btn w-full justify-center">Send message</button>
  </form>
</div>
