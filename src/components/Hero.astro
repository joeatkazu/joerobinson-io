<section class="border-b-2 border-foreground">
  <div class="container py-16 md:py-24">
    <span class="inline-block bg-primary text-primary-foreground text-[11px] sm:text-xs font-bold uppercase tracking-[0.1em] px-3 py-1.5">
      B2B SaaS SEO and GEO
    </span>

    <h1 class="mt-7 max-w-[13ch] lg:text-[6.5rem]">
      More leads from <span class="text-primary">search.</span>
    </h1>

    <div class="grid md:grid-cols-2 gap-10 md:gap-12 mt-12 items-end">
      <div class="space-y-4">
        <p class="font-heading font-bold text-xl tracking-[-0.025em] text-foreground">
          Hi, I'm Joe Robinson,
        </p>
        <p class="text-lg text-muted-foreground max-w-[46ch]">
          I work out which questions your buyers are asking their LLM, who is being recommended and
          why, and what specifically needs to be done to get you into those answers.
        </p>
      </div>
      <div class="md:justify-self-start">
        <a href="/contact" class="btn">
          Talk to me about SEO and AI search
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
