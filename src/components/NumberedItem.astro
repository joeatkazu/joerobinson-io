---
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="grid md:grid-cols-[5rem_1fr] gap-4 md:gap-10 py-8 md:py-10 border-t border-border first:border-t-0 first:pt-0">
  <div class="font-heading font-bold text-2xl md:text-3xl text-primary leading-none tracking-[-0.04em]">
    {number}
  </div>
  <div>
    <h3 class="mb-3 max-w-[26ch]">{title}</h3>
    <div class="text-muted-foreground text-base md:text-lg space-y-4 max-w-[68ch]">
      <slot />
    </div>
  </div>
</div>
