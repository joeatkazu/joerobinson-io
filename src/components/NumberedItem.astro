---
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="border-t border-border py-7 first:border-t-0 first:pt-0">
  <h3 class="flex gap-3">
    <span class="text-primary shrink-0">[{number}]</span>
    <span class="max-w-[46ch]">{title}</span>
  </h3>
  <div class="mt-3 md:pl-[3.9rem] text-muted-foreground text-sm md:text-[15px] leading-relaxed space-y-4 max-w-[76ch]">
    <slot />
  </div>
</div>
