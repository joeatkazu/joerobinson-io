---
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="grid md:grid-cols-[3.75rem_1fr] gap-2 md:gap-5 border-t border-border py-7">
  <span class="font-mono text-xs text-muted-foreground/70 md:pt-1.5">{number}</span>
  <div>
    <h3 class="max-w-[46ch]">{title}</h3>
    <div class="mt-3 text-muted-foreground text-sm md:text-[15px] leading-relaxed space-y-4 max-w-[68ch]">
      <slot />
    </div>
  </div>
</div>
