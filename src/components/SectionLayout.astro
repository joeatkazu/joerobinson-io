---
interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
  id?: string;
  /** Drop the heavy bottom rule (use on the last section before the footer) */
  noRule?: boolean;
}

const { title, subtitle, class: className = '', id, noRule = false } = Astro.props;
---

<section
  class:list={['py-16 md:py-24', !noRule && 'border-b-2 border-foreground', className]}
  id={id}
>
  <div class="container">
    {(title || subtitle) && (
      <div class="mb-10 md:mb-12">
        {title && <span class="eyebrow">{title}</span>}
        {subtitle && <h2 class="max-w-[20ch]">{subtitle}</h2>}
      </div>
    )}
    <slot />
  </div>
</section>
