      <div>
        <p class="font-semibold text-foreground">Joe Robinson</p>
        <p class="text-muted-foreground mt-2">SEO and GEO consultant for B2B SaaS companies</p>
        <p class="text-muted-foreground">Two or three retained clients at a time.</p>
      </div>
      <div class="flex flex-col md:items-end gap-2">
        <div class="flex gap-5 text-muted-foreground">
          <a href="mailto:joe@joerobinson.io" class="hover:text-primary transition-colors">Email</a>
          <a
            href="https://www.linkedin.com/in/robinson-j/"
            target="_blank"
