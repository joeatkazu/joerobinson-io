---
const year = new Date().getFullYear();
---

<footer class="border-t-2 border-foreground">
  <div class="container py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div>
        <p class="font-heading font-bold text-lg uppercase tracking-[-0.03em] text-foreground">
          Joe Robinson
        </p>
        <p class="text-sm text-muted-foreground mt-2">B2B SaaS SEO and GEO consultant</p>
        <p class="text-sm text-muted-foreground">Two or three retained clients at a time.</p>
      </div>
      <div class="flex flex-col md:items-end gap-2 text-sm">
        <div class="flex gap-6 font-bold uppercase tracking-[0.08em]">
          <a href="mailto:joe@joerobinson.io" class="hover:text-primary transition-colors">Email</a>
          <a
            href="https://www.linkedin.com/in/robinson-j/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors"
          >LinkedIn</a>
          <a href="/blog" class="hover:text-primary transition-colors">Writing</a>
        </div>
        <p class="text-xs text-muted-foreground mt-2">&copy; {year} Joe Robinson</p>
      </div>
    </div>
  </div>
</footer>
