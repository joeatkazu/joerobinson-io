---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Work', path: '/#work' },
  { label: 'Services', path: '/#services' },
  { label: 'Writing', path: '/blog' },
  { label: 'Contact', path: '/contact' },
];

function isActive(linkPath: string): boolean {
  if (linkPath.startsWith('/#')) return false;
  return currentPath.startsWith(linkPath);
}
---

<header class="w-full bg-background border-b-2 border-foreground">
  <div class="container flex justify-between items-center py-5">
    <a
      href="/"
      class="font-heading font-bold text-lg tracking-[-0.03em] uppercase text-foreground hover:text-primary transition-colors"
    >
      Joe Robinson
    </a>
    <nav class="flex items-center gap-5 sm:gap-7 text-xs sm:text-sm font-semibold uppercase tracking-[0.06em]">
      {navLinks.map((link) => (
        <a
          href={link.path}
          class:list={[
            'transition-colors hover:text-primary',
            isActive(link.path) ? 'text-primary' : 'text-foreground',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
