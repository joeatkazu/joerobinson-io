---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Work', path: '/#work' },
  { label: 'Services', path: '/#services' },
  { label: 'Writing', path: '/blog' },
  { label: 'Contact', path: '/contact' },
];

function isActive(linkPath: string): boolean {
  if (linkPath.startsWith('/#')) return false;
  return currentPath.startsWith(linkPath);
}
---

<header class="w-full">
  <div class="container flex flex-wrap justify-between items-baseline gap-x-8 gap-y-2 py-5 md:py-6">
    <a href="/" class="text-[17px] font-semibold tracking-[-0.01em] text-foreground hover:text-primary transition-colors">
      Joe Robinson
    </a>
    <nav aria-label="Main" class="flex items-center gap-5 sm:gap-7 text-[15px]">
      {navLinks.map((link) => (
        <a
          href={link.path}
          aria-current={isActive(link.path) ? 'page' : undefined}
          class:list={[
            'transition-colors hover:text-primary',
            isActive(link.path) ? 'text-foreground underline decoration-primary decoration-2 underline-offset-[6px]' : 'text-muted-foreground',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
