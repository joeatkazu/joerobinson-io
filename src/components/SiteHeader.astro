---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Work', path: '/#work' },
  { label: 'Services', path: '/#services' },
  { label: 'Writing', path: '/blog' },
  { label: 'Contact', path: '/contact' },
];

function isActive(linkPath: string): boolean {
  if (linkPath.startsWith('/#')) return false;
  return currentPath.startsWith(linkPath);
}
---

<header class="w-full bg-background border-b border-border">
  <div class="container flex justify-between items-center py-4">
    <a href="/" class="text-sm text-foreground hover:text-primary transition-colors">
      <span class="text-primary mr-1.5" aria-hidden="true">&#9613;</span>Joe Robinson
    </a>
    <nav class="flex items-center gap-4 sm:gap-6 text-xs sm:text-sm">
      {navLinks.map((link) => (
        <a
          href={link.path}
          class:list={[
            'transition-colors hover:text-primary',
            isActive(link.path) ? 'text-primary' : 'text-muted-foreground',
          ]}
        >
          <span class="text-border" aria-hidden="true">/</span>{link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
