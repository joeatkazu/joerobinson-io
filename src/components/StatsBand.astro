---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  note?: string;
}

const { stats, note } = Astro.props;
---

<section>
  <div class="container">
    <div class="sheet">
      <span class="eyebrow">[00] Results</span>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 border-t border-border pt-8">
        {stats.map((stat) => (
          <div>
            <div class="text-[28px] font-semibold tracking-[-0.04em] text-primary">{stat.value}</div>
            <p class="mt-2 text-[13px] text-muted-foreground leading-relaxed">{stat.label}</p>
          </div>
        ))}
      </div>

      {note && (
        <div class="mt-10 pt-6 border-t border-border">
          <p class="text-sm text-muted-foreground max-w-[70ch]">{note}</p>
        </div>
      )}
    </div>
  </div>
</section>
