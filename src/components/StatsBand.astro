---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  note?: string;
}

const { stats, note } = Astro.props;
---

<section class="border-b border-border py-14 md:py-20">
  <div class="container">
    <div class="flex items-baseline gap-3 text-xs sm:text-sm mb-8">
      <span class="text-primary">[00]</span>
      <span class="text-foreground uppercase tracking-[0.08em]">Results</span>
      <span class="leader"></span>
    </div>

    <table class="w-full text-sm">
      <tbody>
        {stats.map((stat) => (
          <tr class="border-b border-border align-baseline">
            <td class="py-4 pr-8 text-primary whitespace-nowrap">{stat.value}</td>
            <td class="py-4 text-muted-foreground leading-relaxed">{stat.label}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {note && <p class="mt-6 text-sm text-muted-foreground max-w-[70ch]">{note}</p>}
  </div>
</section>
