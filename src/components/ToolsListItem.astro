---
interface Props {
  name: string;
  description: string;
  url: string;
}

const { name, description, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-start justify-between gap-6 border-t border-border py-6 first:border-t-0 first:pt-0"
>
  <div>
    <h3 class="text-lg md:text-xl mb-2 group-hover:text-primary transition-colors">{name}</h3>
    <p class="text-muted-foreground max-w-[60ch]">{description}</p>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-muted-foreground group-hover:text-primary transition-colors shrink-0 mt-2"
    aria-hidden="true"
  >
    <path d="M15 3h6v6"/>
    <path d="M10 14 21 3"/>
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
  </svg>
</a>
