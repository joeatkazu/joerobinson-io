---
interface Props {
  name: string;
  description: string;
  url: string;
}

const { name, description, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-start justify-between gap-6 border-t border-border py-5"
>
  <div>
    <h3 class="group-hover:text-primary transition-colors">{name}</h3>
    <p class="mt-2 text-sm text-muted-foreground leading-relaxed max-w-[70ch]">{description}</p>
  </div>
  <span class="font-mono text-xs text-muted-foreground/60 group-hover:text-primary transition-colors shrink-0 mt-1.5" aria-hidden="true">[&#8599;]</span>
</a>
