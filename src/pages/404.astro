---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Page not found | Joe Robinson">
  <SiteHeader />
  <section class="border-b-2 border-foreground">
    <div class="container py-20 md:py-28">
      <span class="eyebrow">Error 404</span>
      <h1 class="text-5xl sm:text-6xl md:text-7xl">Page not <span class="text-primary">found.</span></h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-[46ch] mt-6 mb-10">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn">
        Back to home
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </section>
  <SiteFooter />
</BaseLayout>
