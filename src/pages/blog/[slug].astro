---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CTABlock from '../../components/CTABlock.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const date = post.data.publishedDate ?? post.data.published ?? '';
---

<BaseLayout title={`${post.data.title} | Joe Robinson`} description={post.data.description}>
  <SiteHeader />

  <header>
    <div class="container">
      <div class="sheet sheet-top py-14 md:py-20">
      <a
        href="/blog"
        class="label inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors mb-8"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        All writing
      </a>

      {date && (
        <span class="label block text-primary mb-5">{date}</span>
      )}
      <h1 class="max-w-[20ch]">{post.data.title}</h1>
      {post.data.description && (
        <p class="mt-6 text-lg text-muted-foreground max-w-[60ch]">{post.data.description}</p>
      )}
      </div>
    </div>
  </header>

  <article>
    <div class="container">
      <div class="sheet">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <CTABlock
    heading="Working on this yourself?"
    text="If you need someone to own organic and AI search at your B2B SaaS company, start a conversation."
  />
  <SiteFooter />
</BaseLayout>
