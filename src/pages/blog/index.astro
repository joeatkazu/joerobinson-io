---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CTABlock from '../../components/CTABlock.astro';

const allPosts = await getCollection('blog');
const articles = allPosts.sort((a, b) => {
  const dateA = a.data.publishedDate ?? a.data.published ?? '';
  const dateB = b.data.publishedDate ?? b.data.published ?? '';
  return new Date(dateB).getTime() - new Date(dateA).getTime();
});
---

<BaseLayout
  title="Writing on SEO, GEO and organic growth | Joe Robinson"
  description="Writing on SEO, AI search, content systems and organic growth for B2B SaaS."
>
  <SiteHeader />

  <section>
    <div class="container">
      <div class="sheet sheet-top py-16 md:py-20">
      <span class="eyebrow">Writing</span>
      <h1 class="max-w-[16ch]">
        Notes on SEO, <span class="text-primary">AI search</span> and growth
      </h1>
      <p class="mt-6 text-lg text-muted-foreground max-w-[52ch]">
        What I'm seeing in organic and AI search, and what I'd do about it.
      </p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="sheet">
      <div class="flex flex-col">
        {articles.map((post) => (
          <ArticleCard
            title={post.data.title}
            excerpt={post.data.description}
            date={post.data.publishedDate ?? post.data.published ?? ''}
            slug={post.slug}
          />
        ))}
      </div>
      </div>
    </div>
  </section>

  <CTABlock />
  <SiteFooter />
</BaseLayout>
