---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact | Joe Robinson"
  description="Get in touch to discuss SEO strategy, AI search visibility, or organic growth for SaaS and tech companies."
>
  <SiteHeader />

  <section>
    <div class="container">
      <div class="sheet sheet-top py-16 md:py-20">
        <span class="eyebrow">Contact</span>
        <h1 class="max-w-[14ch]">
          Let's talk about <span class="text-primary">search.</span>
        </h1>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="sheet">
        <ContactForm />
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>
