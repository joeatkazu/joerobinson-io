---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CTABlock from '../components/CTABlock.astro';

const allPosts = await getCollection('blog');
const recentArticles = allPosts
  .sort((a, b) => {
    const dateA = a.data.publishedDate ?? a.data.published ?? '';
    const dateB = b.data.publishedDate ?? b.data.published ?? '';
    return new Date(dateB).getTime() - new Date(dateA).getTime();
  })
  .slice(0, 3);

const leadResult = {
  value: '+40%',
  label: 'MQLs',
  body: 'For a well-known B2B SaaS in seven months, following changes to organic acquisition and content strategy.',
};

const results = [
  {
    title: '+300% organic traffic',
    body: 'For a B2B technology manufacturer in 12 months, including entering new markets in France and Spain.',
  },
  {
    title: '€250k annual contract',
    body: 'A global luxury fashion brand cited my content article as a key factor in its decision to sign.',
  },
  {
    title: '600,000 pages',
    body: 'A programmatic site that reached about 1,000 organic sessions a day within six months of launch.',
  },
];

const services = [
  {
    title: 'Research and planning',
    body: 'I study your buyers, competitors and existing performance. This includes customer reviews, sales material and CRM data, alongside search data and a technical audit. I use the findings to decide what needs attention. We agree the priorities, how to measure progress and what your team can realistically deliver.',
  },
  {
    title: 'AI search visibility and digital PR',
    body: 'I test how often AI search recommends your company and your competitors, using questions drawn from buyer language. I examine the sentiment and sources behind those answers. The work can include changes to your website, review profiles and structured data, alongside digital PR, link building and Reddit campaigns.',
  },
  {
    title: 'Content strategy and writing',
    body: "I plan and write content around the questions buyers ask when choosing software. This includes product, use case and comparison pages. I also edit your team's drafts and update, combine or remove older content. When I use AI for drafting, the process includes checks against source material and editorial review.",
  },
  {
    title: 'Technical SEO and site development',
    body: 'I investigate problems with crawling, rendering, indexing and internal links. I also handle SEO requirements for migrations and international sites. For programmatic sites, I plan page templates, URLs and linking rules. I write requirements for developers, check their implementation and monitor the site after launch.',
  },
  {
    title: 'Conversion and reporting',
    body: 'I review landing pages, comparison tables and enquiry forms to see where visitors drop out. I use analytics, user recordings and CRM data to propose and test changes. Reporting covers leads, sales opportunities and search performance. I explain where attribution is incomplete and what we can reasonably conclude.',
  },
];

const engagements = [
  {
    title: 'Ongoing SEO and GEO',
    body: 'A monthly retainer for ongoing strategy and delivery. We agree the scope around your priorities and the people you already have. I can lead the work or support your existing team.',
  },
  {
    title: 'AI search visibility review',
    body: 'A project to measure your visibility across the main AI search engines and compare it with competitors. You receive the findings, the sources behind the answers and a prioritised plan. This can stand alone or form the opening stage of a retainer.',
  },
  {
    title: 'Content and programmatic projects',
    body: 'I plan content production processes and programmatic sites. The scope can include page structure, editorial guidance, AI-assisted drafting and quality checks. I can arrange engineering support if needed, with continued support after launch agreed as part of the project.',
  },
];
---

<BaseLayout
  title="SEO & GEO Consultant for B2B SaaS | Joe Robinson"
  description="SEO and GEO consultant for B2B SaaS. Research, content, technical SEO, AI search visibility and digital PR, with ongoing support or project work."
>
  <SiteHeader />

  <main>
    <Hero />

    <!-- Selected results -->
    <section id="work" aria-labelledby="work-heading" class="bg-secondary scroll-mt-4">
      <div class="container py-14 md:py-20">
        <div class="grid lg:grid-cols-12 gap-x-12 gap-y-8">
          <div class="lg:col-span-4">
            <h2 id="work-heading">Selected results</h2>
          </div>

          <div class="lg:col-span-8">
            <div class="border-t-2 border-foreground pt-6">
              <h3 class="text-[3.5rem] md:text-[4.5rem] leading-none font-semibold tracking-[-0.03em] text-primary">
                {leadResult.value}
                <span class="text-[2rem] md:text-[2.5rem] tracking-[-0.02em] text-foreground">{leadResult.label}</span>
              </h3>
              <p class="mt-4 text-xl md:text-2xl leading-snug font-medium text-foreground max-w-[38ch]">{leadResult.body}</p>
            </div>

            <div class="mt-10">
              {results.map((result) => (
                <div class="grid sm:grid-cols-[14rem_1fr] gap-x-6 gap-y-1.5 border-t border-border py-5">
                  <h3 class="text-xl sm:text-[1.375rem] leading-snug font-semibold tracking-[-0.02em]">{result.title}</h3>
                  <p class="text-muted-foreground leading-relaxed sm:pt-0.5">{result.body}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What I do -->
    <section aria-labelledby="scope-heading">
      <div class="container py-14 md:py-20">
        <div class="grid lg:grid-cols-12 gap-x-12 gap-y-8">
          <div class="lg:col-span-4">
            <h2 id="scope-heading" class="lg:sticky lg:top-8">What I do</h2>
          </div>
          <div class="lg:col-span-8">
            {services.map((item) => (
              <div class="border-t border-border py-7 first:pt-6">
                <h3>{item.title}</h3>
                <p class="mt-3 text-muted-foreground leading-relaxed max-w-[66ch]">{item.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- How I work -->
    <section aria-labelledby="how-heading" class="bg-secondary">
      <div class="container py-14 md:py-20">
        <h2 id="how-heading">How I work</h2>
        <p class="mt-6 text-xl md:text-[1.375rem] leading-snug text-foreground max-w-[52ch]">
          I work directly with your marketing, product and engineering teams, using your tools and planning schedule. I do much of the research, writing and technical work myself, including changes in your CMS.
        </p>
        <div class="mt-8 grid md:grid-cols-2 gap-x-12 gap-y-4 text-muted-foreground leading-relaxed">
          <p>When developers are needed, I write the requirements and check the finished work. I follow up on problems until they are resolved.</p>
          <p>I've hired and led content, link-building and project teams, and improved SEO delivery at an agency of around 30 people. I can help your team with processes and editorial standards as well as the work itself. You'll get regular updates on progress, problems and changes to the plan.</p>
        </div>
      </div>
    </section>

    <!-- Working together -->
    <section id="services" aria-labelledby="services-heading" class="scroll-mt-4">
      <div class="container py-14 md:py-20">
        <h2 id="services-heading">Working together</h2>
        <div class="mt-8">
          {engagements.map((item) => (
            <div class="grid lg:grid-cols-12 gap-x-12 gap-y-2 border-t border-border py-7">
              <h3 class="lg:col-span-4 text-xl">{item.title}</h3>
              <p class="lg:col-span-8 text-muted-foreground leading-relaxed max-w-[66ch]">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Writing -->
    <section aria-labelledby="writing-heading" class="border-t border-border">
      <div class="container py-14 md:py-20">
        <div class="flex flex-wrap items-baseline justify-between gap-4 mb-6">
          <h2 id="writing-heading">Recent writing</h2>
          <a href="/blog" class="link-accent text-[15px]">
            All articles
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="flex flex-col">
          {recentArticles.map((post) => (
            <ArticleCard
              title={post.data.title}
              excerpt={post.data.description}
              date={post.data.publishedDate ?? post.data.published ?? ''}
              slug={post.slug}
              compact
            />
          ))}
        </div>
      </div>
    </section>

    <CTABlock
      heading="Let's talk"
      text="Tell me what you're working on and where you need help with SEO or AI search."
      linkText="Get in touch"
      linkTo="/contact"
      showLinkedIn={false}
    />
  </main>

  <SiteFooter />
</BaseLayout>
